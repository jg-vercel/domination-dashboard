# Server-only secrets are added in Issue #3.
# Never prefix authentication or DomiNations credentials with NEXT_PUBLIC_.

# Optional override for the public, read-only country diagnostic endpoint.
# DOMINATIONS_COUNTRY_ENDPOINT=https://api.dominationsworld.com/api/gameident/getplayercountry

# Google Web OAuth client. Register this local redirect URI:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this verified Google email may access the dashboard.
ADMIN_GOOGLE_EMAIL=

# Generate at least 32 random characters. Used only for server-side AES-GCM keys.
APP_SESSION_SECRET=

# Optional locally. Required in production, without a trailing slash.
# APP_BASE_URL=http://localhost:3000

# Required for distributed claim locks and cycle idempotency on Vercel.
# Provision through the Vercel Marketplace Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
