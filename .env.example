# Server-only secrets are required for Google OAuth and encrypted sessions.
# Never prefix authentication or DomiNations credentials with NEXT_PUBLIC_.

# Optional override for the public, read-only country diagnostic endpoint.
# DOMINATIONS_COUNTRY_ENDPOINT=https://api.dominationsworld.com/api/gameident/getplayercountry

# Google Web OAuth client. Register this local redirect URI:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate at least 32 random characters. Used for OAuth flow cookies and
# encrypted Upstash server-session values.
APP_SESSION_SECRET=

# Optional locally. Required in production, without a trailing slash.
# APP_BASE_URL=http://localhost:3000

# Required for encrypted authentication sessions, distributed claim locks,
# cycle idempotency, and safe audit records on Vercel.
# Provision through the Vercel Marketplace Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
